{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowledger.dev/schemas/commands/payment-operation-reconcile.v1.schema.json",
  "title": "Reconcile payment operation command v1",
  "allOf": [
    { "$ref": "../common/message-envelope.v1.schema.json" },
    {
      "properties": {
        "kind": { "const": "COMMAND" },
        "type": { "const": "payment.operation.reconcile.v1" },
        "schemaVersion": { "const": 1 },
        "aggregateType": { "const": "payment" },
        "aggregateId": { "$ref": "../common/entity-ids.v1.schema.json#/$defs/paymentId" },
        "orderingKey": { "$ref": "../common/entity-ids.v1.schema.json#/$defs/paymentId" },
        "data": { "$ref": "#/$defs/data" }
      }
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "required": ["operationId", "paymentId", "reason", "notBefore", "reconciliationAttempt"],
      "properties": {
        "operationId": { "$ref": "../common/entity-ids.v1.schema.json#/$defs/paymentOperationId" },
        "paymentId": { "$ref": "../common/entity-ids.v1.schema.json#/$defs/paymentId" },
        "reason": {
          "enum": [
            "AMBIGUOUS_RESPONSE",
            "STALE_PROCESSING",
            "PROVIDER_NOTIFICATION_GAP",
            "MANUAL_RECHECK"
          ]
        },
        "notBefore": { "type": "string", "format": "date-time" },
        "reconciliationAttempt": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
