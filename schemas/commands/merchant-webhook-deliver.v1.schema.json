{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowledger.dev/schemas/commands/merchant-webhook-deliver.v1.schema.json",
  "title": "Deliver merchant webhook command v1",
  "allOf": [
    { "$ref": "../common/message-envelope.v1.schema.json" },
    {
      "properties": {
        "kind": { "const": "COMMAND" },
        "type": { "const": "merchant.webhook.deliver.v1" },
        "schemaVersion": { "const": 1 },
        "aggregateType": { "const": "webhook_delivery" },
        "aggregateId": { "$ref": "../common/entity-ids.v1.schema.json#/$defs/webhookDeliveryId" },
        "orderingKey": { "$ref": "../common/entity-ids.v1.schema.json#/$defs/webhookEndpointId" },
        "data": { "$ref": "#/$defs/data" }
      }
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "required": ["deliveryId", "endpointId", "domainEventId"],
      "properties": {
        "deliveryId": { "$ref": "../common/entity-ids.v1.schema.json#/$defs/webhookDeliveryId" },
        "endpointId": { "$ref": "../common/entity-ids.v1.schema.json#/$defs/webhookEndpointId" },
        "domainEventId": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false
    }
  }
}
