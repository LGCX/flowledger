{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowledger.dev/schemas/commands/payment-operation-execute.v1.schema.json",
  "title": "Execute payment operation command v1",
  "allOf": [
    { "$ref": "../common/message-envelope.v1.schema.json" },
    {
      "properties": {
        "kind": { "const": "COMMAND" },
        "type": { "const": "payment.operation.execute.v1" },
        "schemaVersion": { "const": 1 },
        "aggregateType": { "const": "payment" },
        "aggregateId": { "$ref": "../common/entity-ids.v1.schema.json#/$defs/paymentId" },
        "orderingKey": { "$ref": "../common/entity-ids.v1.schema.json#/$defs/paymentId" },
        "data": { "$ref": "#/$defs/data" }
      }
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "required": ["operationId", "paymentId", "provider", "expectedPaymentVersion"],
      "properties": {
        "operationId": { "$ref": "../common/entity-ids.v1.schema.json#/$defs/paymentOperationId" },
        "paymentId": { "$ref": "../common/entity-ids.v1.schema.json#/$defs/paymentId" },
        "provider": {
          "type": "string",
          "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "maxLength": 63
        },
        "expectedPaymentVersion": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
