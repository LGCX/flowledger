{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowledger.dev/schemas/events/payment-discrepancy-detected.v1.schema.json",
  "title": "Payment discrepancy detected event v1",
  "allOf": [
    { "$ref": "../common/message-envelope.v1.schema.json" },
    {
      "properties": {
        "kind": { "const": "EVENT" },
        "type": { "const": "payment.discrepancy.detected.v1" },
        "schemaVersion": { "const": 1 },
        "aggregateType": { "const": "payment" },
        "aggregateId": { "$ref": "../common/entity-ids.v1.schema.json#/$defs/paymentId" },
        "orderingKey": { "$ref": "../common/entity-ids.v1.schema.json#/$defs/paymentId" },
        "data": { "$ref": "#/$defs/data" }
      }
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "required": [
        "paymentId",
        "operationId",
        "providerAccountId",
        "providerOperationId",
        "caseId",
        "classification",
        "internalEvidenceRef",
        "providerEvidenceRef",
        "detectedAt"
      ],
      "properties": {
        "paymentId": { "$ref": "../common/entity-ids.v1.schema.json#/$defs/paymentId" },
        "operationId": { "$ref": "../common/entity-ids.v1.schema.json#/$defs/paymentOperationId" },
        "providerAccountId": { "$ref": "../common/entity-ids.v1.schema.json#/$defs/providerAccountId" },
        "providerOperationId": { "type": ["string", "null"], "minLength": 1, "maxLength": 255 },
        "caseId": { "$ref": "../common/entity-ids.v1.schema.json#/$defs/reviewCaseId" },
        "classification": {
          "enum": [
            "PROVIDER_EFFECT_MISSING_INTERNALLY",
            "INTERNAL_SUCCESS_MISSING_AT_PROVIDER",
            "AMOUNT_MISMATCH",
            "CURRENCY_MISMATCH",
            "STATUS_MISMATCH",
            "DUPLICATE_PROVIDER_EFFECT",
            "MISSING_LEDGER_POSTING",
            "CONTRADICTORY_PROVIDER_EVIDENCE"
          ]
        },
        "internalStatus": { "type": ["string", "null"], "maxLength": 100 },
        "providerStatus": { "type": ["string", "null"], "maxLength": 100 },
        "internalEvidenceRef": { "type": "string", "minLength": 1, "maxLength": 255 },
        "providerEvidenceRef": { "type": "string", "minLength": 1, "maxLength": 255 },
        "detectedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
