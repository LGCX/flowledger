{
  "name": "flowledger",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "test:unit": "vitest run --project unit",
    "test:contracts": "vitest run --project contracts",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:contracts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@flowledger/app-api": "workspace:*",
    "@flowledger/app-merchant-webhook-dispatcher": "workspace:*",
    "@flowledger/app-merchant-webhook-projector": "workspace:*",
    "@flowledger/app-outbox-relay": "workspace:*",
    "@flowledger/app-payment-worker": "workspace:*",
    "@flowledger/app-provider-webhook-receiver": "workspace:*",
    "@flowledger/app-provider-webhook-worker": "workspace:*",
    "@flowledger/app-reconciler": "workspace:*",
    "@flowledger/app-settlement-worker": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
