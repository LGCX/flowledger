{
  "name": "flowledger",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "test:unit": "vitest run --project unit",
    "test:contracts": "vitest run --project contracts",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "check": "pnpm lint && pnpm contracts:check && pnpm typecheck && pnpm test:unit && pnpm test:contracts",
    "db:up": "docker compose -f infra/docker/compose.yaml up -d --wait",
    "db:down": "docker compose -f infra/docker/compose.yaml down -v",
    "contracts:generate": "node scripts/contracts-generate.mjs",
    "contracts:check": "node scripts/contracts-check.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "9.39.5",
    "@flowledger/app-api": "workspace:*",
    "@flowledger/app-cli": "workspace:*",
    "@flowledger/app-merchant-webhook-dispatcher": "workspace:*",
    "@flowledger/app-merchant-webhook-projector": "workspace:*",
    "@flowledger/app-outbox-relay": "workspace:*",
    "@flowledger/app-payment-worker": "workspace:*",
    "@flowledger/app-provider-simulator": "workspace:*",
    "@flowledger/app-provider-webhook-receiver": "workspace:*",
    "@flowledger/app-provider-webhook-worker": "workspace:*",
    "@flowledger/app-reconciler": "workspace:*",
    "@flowledger/app-settlement-worker": "workspace:*",
    "@flowledger/config": "workspace:*",
    "@flowledger/contracts": "workspace:*",
    "@flowledger/database": "workspace:*",
    "@flowledger/domain": "workspace:*",
    "@flowledger/messaging": "workspace:*",
    "@flowledger/observability": "workspace:*",
    "@flowledger/providers": "workspace:*",
    "@flowledger/testkit": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "7.13.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
