# Local-development environment. Every value is synthetic; nothing here is a real
# credential. Copy to infra/docker/.env only if you need to override a default.
# Every variable is documented in docs/CONFIG.md, and that table is the source of truth.

# Consumer: packages/config/src/base.ts (parseBaseConfig) — every app.
NODE_ENV=development

# Consumer: packages/config/src/base.ts (parseBaseConfig) — shutdown grace for every app.
SHUTDOWN_GRACE_MS=10000

# Consumer: apps/api (readPort) — merchant API listening port.
API_PORT=3000

# Consumer: the eight worker apps (readPort) — health/readiness port; 0 binds ephemeral.
HEALTH_PORT=0

# Consumer: apps/provider-simulator (readPort) — simulator HTTP port.
SIMULATOR_PORT=3100

# Consumer: apps/provider-simulator (readFlag) — enables /__test/* control endpoints.
SIMULATOR_TEST_ENDPOINTS=1

# Consumer: infra/docker/compose.yaml (postgres service) — superuser password.
POSTGRES_PASSWORD=flowledger_local_only

# Consumer: infra/docker/postgres-init/10-simulator-db.sh — fl_simulator login role.
FL_SIMULATOR_PASSWORD=fl_simulator_local_only

# Consumer: infra/docker/postgres-init/10-simulator-db.sh — fl_simulator_truth read-only role.
FL_SIMULATOR_TRUTH_PASSWORD=fl_simulator_truth_local_only

# Consumer: apps/provider-simulator only — its own owner-role connection string.
PROVIDER_SIMULATOR_DATABASE_URL=postgres://fl_simulator:fl_simulator_local_only@localhost:5432/flowledger_sim

# Consumer: harness only (packages/testkit, flowledger verify) — read-only ground truth.
SIMULATOR_DATABASE_URL=postgres://fl_simulator_truth:fl_simulator_truth_local_only@localhost:5432/flowledger_sim

# Consumer: packages/messaging transport — points the client at the local emulator.
PUBSUB_EMULATOR_HOST=localhost:8085

# Consumer: packages/observability — OTLP/HTTP trace and metric export endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Test-only. Consumer: packages/testkit property-test setup — fixes the fast-check seed so a
# failing generated case reproduces on another machine, and the run count per property.
# Never read by a running process.
FC_SEED=20261108
FC_NUM_RUNS=200

# Consumer: apps/cli (`flowledger migrate`, `seed`) — the migration owner connection. The user in
# this URL must be fl_migration_owner; the runner refuses any other role.
MIGRATION_DATABASE_URL=postgres://fl_migration_owner:fl_local_owner_password@localhost:5432/flowledger

# Consumer: apps/cli (`flowledger migrate --bootstrap`) — superuser connection used only to create
# the migration owner and the database. Optional; leave unset where they already exist.
DATABASE_ADMIN_URL=postgres://postgres:flowledger_local_only@localhost:5432/postgres

# Consumer: apps/cli (migrate) — read by migration 0300+ to size the ledger bucket table. Fixed per
# database at creation; changing it later needs a rebalancing migration.
LEDGER_BUCKET_COUNT=32

# Consumer: apps/cli (migrate) — the ledger environment label stored on the ledger row. LOCAL or
# SANDBOX. Set at creation; it is not a runtime switch.
LEDGER_ENVIRONMENT=LOCAL

# Consumer: apps/cli (migrate) — sets this synthetic password on every local runtime role. Refused
# when NODE_ENV=production. Omit in any environment with managed credentials.
FLOWLEDGER_LOCAL_ROLE_PASSWORD=fl_local_test_password

# Consumer: every service (packages/database) — maximum connections in the process pool.
DATABASE_POOL_MAX=4
# Consumer: apps/cli (`seed`, `credentials issue`) and packages/config/src/cli.ts
# Synthetic only. Format: <version>:<base64url pepper>[,<version>:<base64url pepper>]
API_CREDENTIAL_PEPPERS=1:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8

# Consumer: apps/cli (`credentials issue|revoke`); must connect as fl_operator_command
OPERATOR_DATABASE_URL=postgres://fl_operator_command:flowledger_local_dev@localhost:5432/flowledger
